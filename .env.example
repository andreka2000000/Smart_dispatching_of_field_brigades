# Browser-visible configuration only. Never add provider secrets to NEXT_PUBLIC_*.
NEXT_PUBLIC_DATA_MODE=mock
# For Vercel production: the public HTTPS Go endpoint, without /api/v1.
NEXT_PUBLIC_API_BASE_URL=
# Local development rewrite only. Go API remains separate from Next.js.
API_PROXY_TARGET=http://127.0.0.1:8080
